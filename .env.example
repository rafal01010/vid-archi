# Shared environment
APP_ENV=local
AWS_REGION=ap-northeast-1
VIDEO_POLICY_FILE=config/video_policy.json

# App ports
API_PORT=8080
FRONTEND_PORT=5173
# Local default for direct browser->API calls.
# In STG, set this to the public API URL unless you also configure a reverse proxy that serves frontend and `/api` from the same origin.
PUBLIC_API_BASE_URL=http://127.0.0.1:8080
UPLOAD_PART_SIZE_BYTES=8388608
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_PRESIGN_TTL_SECONDS=900

# Local Postgres
POSTGRES_DB=video_stg
POSTGRES_USER=video_app
POSTGRES_PASSWORD=video_app_local
POSTGRES_PORT=5432
DATABASE_URL=postgres://video_app:video_app_local@127.0.0.1:5432/video_stg

# Local S3-compatible storage via MinIO
LOCAL_S3_ENDPOINT=http://127.0.0.1:9000
LOCAL_S3_REGION=us-east-1
LOCAL_UPLOAD_BUCKET=video-upload-local
LOCAL_PROCESSED_BUCKET=video-processed-local
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Chunker defaults
CHUNKER_POLL_INTERVAL_SECONDS=5
CHUNKER_TEMP_DIR=/tmp/vid-archi-chunker
CHUNKER_ID=
CHUNKER_MAX_PROCESSING_ATTEMPTS=3

# Transcoder defaults
TRANSCODER_POLL_INTERVAL_SECONDS=5
TRANSCODER_TEMP_DIR=/tmp/vid-archi-transcoder
TRANSCODER_ID=
TRANSCODER_RENDITION=360p
TRANSCODER_MAX_ATTEMPTS=3
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Upload cleanup defaults
UPLOAD_ABORT_INCOMPLETE_MULTIPART_AFTER_DAYS=1

# STG AWS inventory values from Section 20A
STG_ALB_DNS=stg-api-alb-816249004.ap-northeast-1.elb.amazonaws.com
CDN_BASE_URL=https://d38ixt0cyn1hi6.cloudfront.net
PROCESSED_ASSET_BASE_URL=
UPLOAD_BUCKET=stg-video-upload-1a
PROCESSED_BUCKET=stg-video-processed-1a
SQS_CHUNKER_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/799168734365/stg-chunker-queue
SQS_TRANSCODER_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/799168734365/stg-transcoder-queue
STG_POSTGRES_DB=vid-archi-db
STG_POSTGRES_USER=video-db-access
STG_POSTGRES_PASSWORD=video-db-password
STG_POSTGRES_PORT=5432
STG_POSTGRES_BIND_ADDRESS=10.0.2.16

# STG runtime DB value consumed by the app host and processing host services.
# This should match the Postgres container settings above.
STG_DATABASE_URL=postgres://video-db-access:video-db-password@10.0.2.16:5432/vid-archi-db
